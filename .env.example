# Copy to .env (gitignored) and fill in. Never commit .env.
# Supabase dashboard → project "nabta" → Connect → Session pooler → URI.
# The password is the database password (Project Settings → Database → Reset database password).
# Paste the URI exactly as the dashboard shows it (the pooler host name varies), then put the password in.
DATABASE_URL=postgresql://postgres.iumdwrwagaawoyurvniu:[YOUR-PASSWORD]@<pooler-host>.pooler.supabase.com:5432/postgres

# Public values for the mobile app (safe to ship in the app; RLS protects the data).
SUPABASE_URL=https://iumdwrwagaawoyurvniu.supabase.co
